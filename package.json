{
  "name": "hardware-intelligence-platform",
  "productName": "Hardware Intelligence Platform",
  "version": "0.1.0",
  "description": "Desktop hardware inventory, live events, topology and diagnostics",
  "author": "Hardware Intelligence Platform contributors",
  "desktopName": "hardware-intelligence-platform.desktop",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "scan": "tsx scripts/scan.ts",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test:watch": "vitest",
    "package:linux": "electron-vite build && electron-builder --linux AppImage --publish never",
    "test:e2e": "electron-vite build && node tests/e2e/run.mjs",
    "test:all": "npm run typecheck && npm test && npm run test:e2e",
    "watch": "tsx scripts/watch.ts",
    "package:win": "electron-vite build && electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "@electron/asar": "^3.4.1",
    "@electron/fuses": "^1.8.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@xyflow/react": "^12.12.0",
    "electron": "^44.9.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.60.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=24"
  }
}
