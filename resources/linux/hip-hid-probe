#!/usr/bin/python3 -I
# Hardware Intelligence Platform - privileged raw HID probe.
#
# Installed root-owned at /usr/local/libexec/hardware-intelligence/hip-hid-probe by
# resources/linux/install.sh and run only through its own polkit action
# (dev.hardware-intelligence.hid.probe); raw /dev/hidraw nodes are root-only. It only reads the one hidraw
# node named on the command line and, for Logitech HID++ devices, sends read-only queries (ping,
# feature lookup, name, firmware, battery, DPI). It never sends a request that changes settings.
#
# Usage: hip-hid-probe hidrawN SECONDS [hidpp]
import json, os, re, select, struct, sys, time

def out(o):
    print(json.dumps(o), flush=True)

def fail(msg):
    print("ERROR " + msg, file=sys.stderr, flush=True)
    sys.exit(2)

args = sys.argv[1:]
if len(args) < 2 or not re.fullmatch(r"hidraw\d{1,3}", args[0]) or not re.fullmatch(r"\d{1,2}", args[1]):
    fail("usage: hidrawN SECONDS [hidpp]")
name, secs, want_hidpp = args[0], int(args[1]), len(args) > 2 and args[2] == "hidpp"
if not 3 <= secs <= 20:
    fail("capture length must be 3-20 seconds")
try:
    fd = os.open("/dev/" + name, os.O_RDWR | os.O_NONBLOCK)
except OSError as e:
    fail("cannot open /dev/%s: %s" % (name, e.strerror))
out({"type": "start"})

SW = 0x0B  # software id (the kernel driver uses 0x01)

def request(feat, func, params=b"", timeout=1.0):
    """One HID++ 2.0 request; returns the reply parameters or None (error or no answer)."""
    msg = bytes([0x10, 0xFF, feat, (func << 4) | SW]) + params
    try:
        os.write(fd, msg.ljust(7, b"\0"))
    except OSError:
        return None
    end = time.monotonic() + timeout
    while True:
        left = end - time.monotonic()
        if left <= 0:
            return None
        r, _, _ = select.select([fd], [], [], left)
        if not r:
            return None
        try:
            d = os.read(fd, 64)
        except BlockingIOError:
            continue
        if len(d) < 5 or d[0] not in (0x10, 0x11):
            continue
        if d[2] == 0x8F or (d[2] == 0xFF and d[3] == feat and (d[4] & 0x0F) == SW):
            return None
        if d[2] == feat and d[3] == ((func << 4) | SW):
            return d[4:]

def feature(fid):
    r = request(0, 0, struct.pack(">H", fid))
    return r[0] if r and r[0] else None

info = {"type": "hidpp", "answered": False}
if want_hidpp:
    ping = request(0, 1, bytes([0, 0, 0x5A]), timeout=2.0)
    if ping and len(ping) >= 3 and ping[2] == 0x5A:
        info["answered"] = True
        info["protocol"] = "%d.%d" % (ping[0], ping[1])
        i = feature(0x0005)
        if i:
            r = request(i, 0)
            if r:
                n, text = r[0], b""
                while len(text) < n:
                    c = request(i, 1, bytes([len(text)]))
                    if not c:
                        break
                    text += c[: n - len(text)]
                info["name"] = text.decode("utf-8", "replace").strip("\0 ")
        i = feature(0x0003)
        if i:
            r = request(i, 0)
            fw = []
            for e in range(min(r[0], 4) if r else 0):
                x = request(i, 1, bytes([e]))
                if x and len(x) >= 8:
                    kinds = {0: "firmware", 1: "bootloader", 2: "hardware", 3: "other"}
                    fw.append("%s %s %02X.%02X build %04X" % (kinds.get(x[0] & 0x0F, "other"), x[1:4].decode("ascii", "replace"), x[4], x[5], struct.unpack(">H", x[6:8])[0]))
            info["firmware"] = fw
        i = feature(0x1004)
        if i:
            r = request(i, 1)
            if r:
                info["battery"] = {"percent": r[0], "levelBits": r[1], "status": r[2]}
        i = feature(0x1000)
        if i and "battery" not in info:
            r = request(i, 0)
            if r:
                info["battery"] = {"percent": r[0], "status": r[2]}
        i = feature(0x1001)
        if i:
            r = request(i, 0)
            if r and len(r) >= 3:
                info["voltage_mV"] = struct.unpack(">H", r[0:2])[0]
        i = feature(0x2201)
        if i:
            r = request(i, 2, bytes([0]))
            if r and len(r) >= 3:
                info["dpi"] = struct.unpack(">H", r[1:3])[0]
out(info)

# Capture: every raw report the device sends while the user moves and clicks it.
out({"type": "capture", "seconds": secs})
t0 = time.monotonic()
end = t0 + secs
count = 0
while count < 20000:
    left = end - time.monotonic()
    if left <= 0:
        break
    r, _, _ = select.select([fd], [], [], left)
    if not r:
        continue
    try:
        d = os.read(fd, 64)
    except BlockingIOError:
        continue
    except OSError as e:
        out({"type": "gone", "error": e.strerror})
        break
    count += 1
    print("R %d %s" % (int((time.monotonic() - t0) * 1000), d.hex()), flush=True)
out({"type": "done", "reports": count})
