{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["node"],
    "paths": { "@shared/*": ["./src/shared/*"], "@collectors/*": ["./src/collectors/*"], "@renderer/*": ["./src/renderer/*"] }
  },
  "include": ["src", "tests", "scripts", "electron.vite.config.ts", "vitest.config.mts"]
}
